{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "weather-app",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["--yes", "serve", "-l", "5173", "weather-app"],
      "port": 5173
    },
    {
      "name": "habit-tracker",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "habit-tracker", "run", "dev", "--", "--port", "5174", "--strictPort"],
      "port": 5174
    },
    {
      "name": "movie-tracker",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "movie-tracker", "run", "dev", "--", "--port", "5175", "--strictPort"],
      "port": 5175
    },
    {
      "name": "ideal-worldcup",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "uvicorn", "app.main:app", "--app-dir", "ideal-worldcup", "--port", "8000", "--reload"],
      "port": 8000
    }
  ]
}
